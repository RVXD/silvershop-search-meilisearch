{
    "name": "silvershop/search-meilisearch",
    "description": "Meilisearch engine adapter for silvershop/search: typo-tolerant, relevance-ranked product search via a self-hosted Meilisearch.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "search", "meilisearch"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-search-meilisearch/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silvershop/core": "^6",
        "silvershop/search": "dev-main",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RVXD/silvershop-search.git"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Search\\Meilisearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Search\\Meilisearch\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
